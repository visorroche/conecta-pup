PORT=3100
# Interface de escuta (producao: 127.0.0.1, o nginx faz o proxy)
HOST=127.0.0.1

# Banco com a tabela customers_bridget (criada automaticamente ao subir a API)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nome_do_banco
DB_USERNAME=usuario
DB_PASSWORD=senha

# Bright Data. Cada cliente (slug) ganha uma zone ISP dedicada criada pela API
# e registrada em customers_bridget. O IP da sessao ainda e escolhido via "-session-<id>".
# false = sobe o Chromium sem proxy e sem criar zones (apenas testes locais)
PROXY_ENABLED=true
BRD_API_URL=https://api.brightdata.com
BRD_API_KEY=sua_api_key_da_brightdata
# host:port gravados em cada nova ponte
BRD_HOST=brd.superproxy.io
BRD_PORT=44445
# Nome da zone = <prefixo><slug>_<hash>; apenas a-z, 0-9 e _
BRD_ZONE_PREFIX=avec_
# IPs dedicados por zone/cliente (cada IP e cobrado pela Bright Data)
BRD_ZONE_IPS=1
# Trava: maximo de zones pagas criadas automaticamente
BRD_MAX_BRIDGES=50

AVEC_ADMIN_BASE=https://admin.avec.beauty
PUPPETEER_HEADLESS=true
# Segundos de inatividade ate o Chromium ser fechado. 0 = nunca (a sessao so cai se a conexao fechar)
SESSION_TTL_SECONDS=0
# Timeout de navegacao/login em ms
LOGIN_TIMEOUT_MS=45000

# Conta de teste AVEC (apenas testes manuais; a API nao le estas variaveis)
TEST_AVEC_SLUG=
TEST_AVEC_EMAIL=
TEST_AVEC_PASSWORD=

# Segredo (HS256) dos tokens JWT emitidos no login: minimo 32 caracteres, aleatorio
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
# Validade do token em segundos (padrao 10 anos)
JWT_TTL_SECONDS=315360000
